    local function setStatsDisplay(state)
        if statsConnection then statsConnection:Disconnect(); statsConnection=nil end
        if statsOverlay then statsOverlay:Destroy();statsOverlay=nil;fpsValueLabel=nil;pingValueLabel=nil end
        if not state then return end
        statsOverlay = Instance.new("Frame")
        statsOverlay.Name = "CatNoir_PingFPS"
        statsOverlay.AnchorPoint = Vector2.new(1, 0)
        statsOverlay.Position = UDim2.new(1, -16, 0, 16)
        statsOverlay.Size = UDim2.fromOffset(252, 58)
        statsOverlay.BackgroundTransparency = 1
        statsOverlay.BorderSizePixel = 0
        statsOverlay.ZIndex = 99
        statsOverlay.Parent = script.Parent
        fpsValueLabel = makeStatCard(statsOverlay, "FPS", Color3.fromRGB(84, 244, 154), 0)
        pingValueLabel = makeStatCard(statsOverlay, "PING", Color3.fromRGB(86, 190, 255), 130)
        local frames, elapsed = 0, 0
        local fpsValue, pingValue = 0, 0
        statsConnection = RunService.RenderStepped:Connect(function(dt)
            if not fpsValueLabel or not fpsValueLabel.Parent or not pingValueLabel or not pingValueLabel.Parent then return end
            frames += 1
            elapsed += dt
            if elapsed >= 0.5 then
                fpsValue = math.floor(frames / math.max(elapsed, 0.001) + 0.5)
                frames, elapsed = 0, 0
                local ok, ping = pcall(function() return LocalPlayer:GetNetworkPing() end)
                if ok and type(ping) == "number" then pingValue = math.floor(ping * 1000 + 0.5) end
                fpsValueLabel.Text = tostring(fpsValue)
                pingValueLabel.Text = tostring(pingValue) .. " ms"
                fpsValueLabel.TextColor3 = fpsValue >= 55 and Color3.fromRGB(84,244,154)
                    or (fpsValue >= 30 and Color3.fromRGB(255,205,92) or Color3.fromRGB(255,105,105))
                pingValueLabel.TextColor3 = pingValue <= 80 and Color3.fromRGB(86,190,255)
                    or (pingValue <= 150 and Color3.fromRGB(255,205,92) or Color3.fromRGB(255,105,105))
            end
        end)
    end
