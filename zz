					text.TextXAlignment = item["Args"][2] == "center" and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
					text.RichText = true
		
		
				elseif item["Type"] == "Keybind" then
                    -- Click to capture a physical key; no text entry is required.
                    local UserInputService = game:GetService("UserInputService")
                    local caption, initial, changed = item["Args"][1], item["Args"][2], item["Args"][3]
                    local button = Instance.new("TextButton")
                    button.Name = "KeybindCapture"
                    button.Parent = frameHolder
                    button.BackgroundColor3 = FUNCTIONSmodule.getTheme().primaryColor
                    button.TextColor3 = FUNCTIONSmodule.getTheme().textColor
                    button.Font = Enum.Font.GothamBold
                    button.TextScaled = true
                    button.Size = UDim2.new(1,0,0,42)
                    Instance.new("UICorner",button)
                    local chosen = initial
                    local waiting = false
                    local captureConnection
                    local function updateText()
                        button.Text = caption .. ": " .. (chosen and chosen.Name or "Desativado")
                    end
                    updateText()
                    button.MouseButton1Click:Connect(function()
                        if waiting then return end
                        waiting = true
                        button.Text = "Pressione uma tecla... (Esc cancela / Backspace limpa)"
                        captureConnection = UserInputService.InputBegan:Connect(function(input)
                            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                            local key = input.KeyCode
                            if key == Enum.KeyCode.Escape then
                                -- No changes.
                            elseif key == Enum.KeyCode.Backspace then
                                chosen = nil
                                item["Args"][2] = nil -- preserve the selected binding when the tab is rendered again
                                changed(nil)
                            elseif key ~= Enum.KeyCode.Unknown and key ~= Enum.KeyCode.K then
                                chosen = key
                                item["Args"][2] = key -- do not restore the original default on a tab change
                                changed(key)
                            else
                                FUNCTIONSmodule.notification("Tecla reservada ou inválida.")
                                return
                            end
                            waiting = false
                            if captureConnection then captureConnection:Disconnect();captureConnection=nil end
                            updateText()
                        end)
                    end)
                    -- The loader destroys and recreates these buttons on each tab switch.
                    -- Release the temporary key listener if the user switches while capturing.
                    button.Destroying:Connect(function()
                        if captureConnection then captureConnection:Disconnect(); captureConnection=nil end
                        waiting=false
                    end)

