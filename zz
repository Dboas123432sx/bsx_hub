    end)
    local function knifePredictedTorso(player,origin)
        local torso,root,hum=knifeTargetTorso(player)
        if not torso or not root then return nil end
        local base=torso.Position
        local record=knifeMotionHistory[player]
        local velocity=(record and record.character==player.Character)
            and record.smoothed or root.AssemblyLinearVelocity
        local ping=knifePingSeconds()
        local travel=math.clamp((base-origin).Magnitude/math.max(knifeProjectileSpeed,1),0,0.75)
        local lead=travel
        for _=1,4 do
            lead=math.clamp(travel+ping*0.5,0,0.85)
            local future=base+velocity*lead
            travel=math.clamp((future-origin).Magnitude/math.max(knifeProjectileSpeed,1),0,0.75)
        end
        lead=math.clamp(travel+ping*0.5,0,0.85)
        local horizontal=knifeHorizontal(velocity)
        -- Ao detectar inversão de direção, confia menos na velocidade antiga.
        local turn=record and record.turnFactor or 0
        local reliability=1-math.clamp(turn,0,1)*0.65
        local horizontalLead=horizontal*lead*reliability
        -- Usa aceleração limitada, sem extrapolar um movimento repentino para longe.
        if record then
            local accel=knifeHorizontal(record.acceleration)
            local correction=accel*(0.5*lead*lead)*reliability
            local maxCorrection=math.min(2.5,math.max(0.3,horizontalLead.Magnitude*0.25))
            if correction.Magnitude>maxCorrection then
                correction=correction.Unit*maxCorrection
            end
            horizontalLead+=correction
        end
        local state=hum:GetState()
        local airborne=state==Enum.HumanoidStateType.Jumping
            or state==Enum.HumanoidStateType.Freefall
        local verticalLead
        if airborne then
            -- Estima subida/queda do tronco com gravidade reduzida e limite conservador.
            verticalLead=velocity.Y*lead-0.5*workspace.Gravity*lead*lead*0.35
            verticalLead=math.clamp(verticalLead,-6,5)
        else
            verticalLead=math.clamp(velocity.Y*lead*0.4,-1.2,1.2)
        end
        return base+horizontalLead+Vector3.new(0,verticalLead,0)
    end
    local function throwKnifeAt(target, silent)
        -- Kill Aura valida a faca equipada, sem depender do papel retornado por playerData.
        local character=LocalPlayer.Character
        if not character then return end
        local knife=character:FindFirstChild("Knife")
        if not knife then
            local hum=character:FindFirstChildOfClass("Humanoid")
            knife=LocalPlayer.Backpack:FindFirstChild("Knife")
            if knife and hum then hum:EquipTool(knife);task.wait() end
        end
        if not knife or not target then return end
        local torso=knifeTargetTorso(target)
        if not torso then return end
        local hand=character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
        local origin=hand and hand.Position or character:GetPivot().Position
        local predicted=knifePredictedTorso(target,origin)
        if not predicted then return end
        -- A checagem de parede orienta a seleção, mas não cancela o comando Ctrl.
        local events=knife:FindFirstChild("Events")
        local remote=events and events:FindFirstChild("KnifeThrown")
        if remote then remote:FireServer(CFrame.new(origin),CFrame.new(predicted)) end
    end

