	local function getSheriffAimPosition(target)
		if not target or not target.Character then return nil end

		local character = target.Character
		local hum = character:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return nil end

		-- Ponto FIXO de mira: centro da barriga/torso.
		-- R15: usa o meio entre LowerTorso e UpperTorso.
		-- R6: usa o centro do Torso.
		local upperTorso = character:FindFirstChild("UpperTorso")
		local lowerTorso = character:FindFirstChild("LowerTorso")
		local torso = character:FindFirstChild("Torso")
			or character:FindFirstChild("HumanoidRootPart")

		local bellyPosition
		local velocityPart

		if upperTorso and lowerTorso then
			bellyPosition = upperTorso.Position:Lerp(lowerTorso.Position, 0.55)
			velocityPart = lowerTorso
		else
			bellyPosition = torso.Position
			velocityPart = torso
		end

		if not bellyPosition or not velocityPart then return nil end

		local myCharacter = LocalPlayer.Character
		local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

		local distance = 0
		if myRoot then
			distance = (bellyPosition - myRoot.Position).Magnitude
		end

		local velocity = velocityPart.AssemblyLinearVelocity
		local moveDirection = hum.MoveDirection
		local state = hum:GetState()

		-- Predição sem ping, mas mantendo o ponto de impacto sempre no centro da barriga.
		local lead = math.clamp(0.07 + (distance / 260), 0.07, 0.40)

		local predicted = bellyPosition + Vector3.new(
			velocity.X,
			0,
			velocity.Z
		) * lead

		-- Pequena compensação de direção sem mudar o ponto vertical da barriga.
		predicted += Vector3.new(moveDirection.X, 0, moveDirection.Z)
			* math.clamp(distance / 150, 0, 1.0)

		if state == Enum.HumanoidStateType.Jumping
			or state == Enum.HumanoidStateType.Freefall then
			predicted += Vector3.new(0, velocity.Y * lead * 0.75, 0)
		end

		return predicted
	end

