    -- Smart Target: prioriza proximidade do centro, distância e visibilidade.
    local function targetWithinCircle()
        local camera=workspace.CurrentCamera
        local char=LocalPlayer.Character
        local myRoot=char and char:FindFirstChild("HumanoidRootPart")
        if not camera or not myRoot then return nil end
        local center=Vector2.new(camera.ViewportSize.X/2,camera.ViewportSize.Y/2)
        local best,bestScore=nil,math.huge
        for _,player in ipairs(Players:GetPlayers()) do
            if player~=LocalPlayer then
                local torso,root=knifeTargetTorso(player)
                if torso and root then
                    local point,visible=camera:WorldToViewportPoint(torso.Position)
                    if visible and point.Z>0 then
                        local screenDist=(Vector2.new(point.X,point.Y)-center).Magnitude
                        if screenDist<=circleRadius then
                            local worldDist=(root.Position-myRoot.Position).Magnitude
                            local unobstructed=knifeCanSee(torso.Position,player.Character)
                            local score=screenDist/math.max(circleRadius,1)*0.75
                                + math.clamp(worldDist/250,0,1)*0.25
                                + (unobstructed and 0 or 0.4)
                            if score<bestScore then best,bestScore=player,score end
                        end
                    end
                end
            end
        end
        return best
    end
