    -- Knife Aimbot V3: detecção adaptativa de movimento, ping e checagem de parede.
    local knifeProjectileSpeed = 190 -- estimativa configurável em studs/s, NÃO é velocidade oficial do MM2
    local function knifePingSeconds()
        local ok, seconds = pcall(function()
            local stats = game:GetService("Stats")
            local item = stats.Network.ServerStatsItem["Data Ping"]
            return item:GetValue() / 1000
        end)
        if ok and type(seconds)=="number" then
            return math.clamp(seconds,0,0.35)
        end
        return 0
    end
    local function knifeTargetTorso(player)
        local char=player and player.Character
        local hum=char and char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health<=0 then return nil,nil,nil end
        local torso=char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
            or char:FindFirstChild("HumanoidRootPart")
        local root=char:FindFirstChild("HumanoidRootPart") or torso
        return torso,root,hum
    end
    local function knifeCanSee(point,targetCharacter)
        local myChar=LocalPlayer.Character
        local originPart=myChar and (myChar:FindFirstChild("RightHand") or myChar:FindFirstChild("Right Arm")
            or myChar:FindFirstChild("HumanoidRootPart"))
        if not originPart then return false end
        local delta=point-originPart.Position
        if delta.Magnitude<0.01 then return true end
        local params=RaycastParams.new()
        params.FilterType=Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances={myChar}
        params.IgnoreWater=true
        local result=workspace:Raycast(originPart.Position,delta,params)
        return not result or (targetCharacter and result.Instance:IsDescendantOf(targetCharacter))
    end
    -- V25: histórico leve de movimento para suavizar ruído e detectar mudanças de direção.
    -- Cada registro pertence ao Player, evitando misturar amostras após respawn.
    local knifeMotionHistory = setmetatable({}, {__mode="k"})
    local knifeMotionAccumulator = 0
    local function knifeHorizontal(v)
        return Vector3.new(v.X,0,v.Z)
    end
    local function knifeSampleMovement(player, now)
        local torso,root,hum=knifeTargetTorso(player)
        if not torso or not root then
            knifeMotionHistory[player]=nil
            return
        end
        local velocity=root.AssemblyLinearVelocity
        local horizontal=knifeHorizontal(velocity)
        local old=knifeMotionHistory[player]
        local sampleDt=old and (now-old.time) or 0
        if not old or old.character~=player.Character or sampleDt<=0 or sampleDt>0.55 then
            knifeMotionHistory[player]={character=player.Character,time=now,
                velocity=velocity,smoothed=velocity,previous=velocity,
                acceleration=Vector3.zero,turnFactor=0,
                localSide=0,localForward=0,state=hum:GetState()}
            return
        end
        local alpha=1-math.exp(-sampleDt*12)
        local smoothed=old.smoothed:Lerp(velocity,alpha)
        local oldHorizontal=knifeHorizontal(old.smoothed)
        local turnFactor=old.turnFactor*math.exp(-sampleDt*7)
        if oldHorizontal.Magnitude>3 and horizontal.Magnitude>3 then
            local dot=math.clamp(oldHorizontal.Unit:Dot(horizontal.Unit),-1,1)
            turnFactor=math.max(turnFactor,math.clamp((0.85-dot)/1.4,0,1))
        end
        local accel=(smoothed-old.smoothed)/math.max(sampleDt,0.016)
        accel=Vector3.new(math.clamp(accel.X,-100,100),
            math.clamp(accel.Y,-90,90),math.clamp(accel.Z,-100,100))
        local look=knifeHorizontal(root.CFrame.LookVector)
        local right=knifeHorizontal(root.CFrame.RightVector)
        local unitLook=look.Magnitude>0.01 and look.Unit or Vector3.new(0,0,-1)
        local unitRight=right.Magnitude>0.01 and right.Unit or Vector3.new(1,0,0)
        knifeMotionHistory[player]={character=player.Character,time=now,
            velocity=velocity,smoothed=smoothed,previous=old.velocity,
            acceleration=accel,turnFactor=turnFactor,
            localSide=horizontal:Dot(unitRight),
            localForward=horizontal:Dot(unitLook),state=hum:GetState()}
    end
    RunService.Heartbeat:Connect(function(dt)
        knifeMotionAccumulator+=dt
        if knifeMotionAccumulator<0.055 then return end
        knifeMotionAccumulator=0
        local now=os.clock()
        for _,player in ipairs(Players:GetPlayers()) do
            if player~=LocalPlayer then knifeSampleMovement(player,now) end
        end
    end)
    Players.PlayerRemoving:Connect(function(player)
