    label(configPanel, "FPS SETTINGS", 22)
    local fpsOn = false
    local fpsSaved = setmetatable({}, {__mode="k"})
    local fpsConnW, fpsConnL
    local fpsLighting = game:GetService("Lighting")
    local fpsOptions = {Particles=true, Images=true, Shadows=true, Materials=true, Effects=true}
    local function saveFpsProp(obj, prop, val)
        if not obj or not obj.Parent then return end
        local record = fpsSaved[obj]
        if not record then record={}; fpsSaved[obj]=record end
        if record[prop]==nil then
            local ok, old = pcall(function() return obj[prop] end)
            if not ok then return end
            record[prop]={old}
        end
        pcall(function() obj[prop]=val end)
    end
    local function fpsProcess(obj)
        if not fpsOn or not obj or not obj.Parent then return end
        if obj:IsDescendantOf(game:GetService("Players")) then return end
        local model=obj:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChildOfClass("Humanoid") then return end
        if obj:FindFirstAncestorOfClass("Tool") then return end
        if fpsOptions.Particles and (obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")) then
            saveFpsProp(obj,"Enabled",false)
        elseif fpsOptions.Images and (obj:IsA("Decal") or obj:IsA("Texture")) then
            saveFpsProp(obj,"Transparency",1)
        elseif fpsOptions.Materials and obj:IsA("BasePart") then
            saveFpsProp(obj,"Material",Enum.Material.Plastic)
            saveFpsProp(obj,"Reflectance",0)
        elseif fpsOptions.Effects and obj:IsA("PostEffect") then
            saveFpsProp(obj,"Enabled",false)
        end
    end
    local function fpsToggle(state)
        fpsOn=state
        if fpsConnW then fpsConnW:Disconnect();fpsConnW=nil end
        if fpsConnL then fpsConnL:Disconnect();fpsConnL=nil end
        if state then
            if fpsOptions.Shadows then saveFpsProp(fpsLighting,"GlobalShadows",false) end
            fpsConnW=workspace.DescendantAdded:Connect(function(obj) task.defer(fpsProcess,obj) end)
            fpsConnL=fpsLighting.DescendantAdded:Connect(function(obj) task.defer(fpsProcess,obj) end)
            task.spawn(function()
                local n=0
                for _,root in ipairs({workspace,fpsLighting}) do
                    for _,obj in ipairs(root:GetDescendants()) do
                        if not fpsOn then return end
                        fpsProcess(obj)
                        n=n+1
                        if n%125==0 then task.wait() end
                    end
                end
            end)
        else
            for obj, properties in pairs(fpsSaved) do
                if obj and obj.Parent then
                    for property, value in pairs(properties) do
                        pcall(function() obj[property]=value[1] end)
                    end
                end
            end
            fpsSaved=setmetatable({},{__mode="k"})
        end
    end
