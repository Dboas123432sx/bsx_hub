	local function findEquippedSheriffGun()
		local character = LocalPlayer.Character
		if not character then return nil end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then return nil end

		local function supportedGun(tool)
			return tool and tool:IsA("Tool") and
				(tool:FindFirstChild("Shoot") and tool.Shoot:IsA("RemoteEvent"))
		end
		for _,obj in ipairs(character:GetChildren()) do
			if supportedGun(obj) then return obj end
		end
		local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
		if backpack then
			for _,obj in ipairs(backpack:GetChildren()) do
				if supportedGun(obj) then
					humanoid:EquipTool(obj)
					task.wait(0.08)
					if obj.Parent == character then return obj end
				end
			end
		end
		return nil
	end

	local function findDuelSheriffTarget()
		local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if not myRoot then return nil end
		local closest, distance = nil, math.huge
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and alive(player) then
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				local bag = player:FindFirstChildOfClass("Backpack")
				local function containsGun(container)
					if not container then return false end
					for _,item in ipairs(container:GetChildren()) do
						if item:IsA("Tool") and (item.Name == "Gun" or
							(item:FindFirstChild("Shoot") and item.Shoot:IsA("RemoteEvent"))) then
							return true
						end
					end
					return false
				end
				local hasGun = containsGun(char) or containsGun(bag)
				if root and hasGun then
					local d = (root.Position - myRoot.Position).Magnitude
					if d < distance then closest, distance = player, d end
				end
			end
		end
		return closest
	end

    -- Duels: detecta equipes oficiais ou atributos de equipe replicados.
    -- Caso nao seja possivel confirmar os dois times, nao atira para evitar aliados.
    local sheriffDuelsMode = false
    local sheriffDuelsRadius = 140
    local teamAttributeNames = {"Team", "TeamName", "TeamId", "TeamID", "DuelTeam", "DuelTeamId", "Side"}
    local function getDuelsTeamToken(player)
        if not player then return nil end
        if player.Team and not player.Neutral then
            return "roblox-team:" .. tostring(player.Team)
        end
        -- A cor so identifica times quando o jogador nao esta neutro.
        if not player.Neutral and player.TeamColor then
            return "roblox-color:" .. tostring(player.TeamColor.Number)
        end
        -- Algumas experiencias replicam a equipe em atributos do jogador.
        for _,key in ipairs(teamAttributeNames) do
            local value = player:GetAttribute(key)
            if value ~= nil and tostring(value) ~= "" then
                return "player-attr:" .. key .. ":" .. tostring(value)
            end
        end
        return nil
    end
    local function isConfirmedDuelsEnemy(player)
        if not player or player == LocalPlayer or not alive(player) then return false end
        local myTeam, theirTeam = getDuelsTeamToken(LocalPlayer), getDuelsTeamToken(player)
        if not myTeam or not theirTeam then
            -- Sheriff vs Murderers: quando o jogo nao replica equipes, usa
            -- papeis confirmados pela arma exclusiva ou pelos dados da rodada.
            -- Sem prova clara dos dois papeis, nao seleciona ninguem.
            if roleOf(LocalPlayer) ~= "Sheriff" then return false end
            return roleOf(player) == "Murderer"
        end
        -- So comparar times da mesma fonte de informacao.
        local myPrefix = myTeam:match("^(.-):")
        local theirPrefix = theirTeam:match("^(.-):")
        if myPrefix ~= theirPrefix then return false end
        -- Para atributos, o nome do atributo tambem deve corresponder.
        if myPrefix == "player-attr" then
            local myKey = myTeam:match("^player%-attr:([^:]+):")
            local theirKey = theirTeam:match("^player%-attr:([^:]+):")
            if myKey ~= theirKey then return false end
        end
        return myTeam ~= theirTeam
    end
    local function sheriffTargetInsideFov()
        local camera = workspace.CurrentCamera
        if not camera then return nil end
        local center = camera.ViewportSize / 2
        local best, bestDistance = nil, math.huge
        for _,player in ipairs(Players:GetPlayers()) do
            if isConfirmedDuelsEnemy(player) then
                local char = player.Character
                local torso = char and (char:FindFirstChild("UpperTorso")
                    or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart"))
                if torso then
                    local point, inViewport = camera:WorldToViewportPoint(torso.Position)
                    if inViewport and point.Z > 0 then
                        local distance = (Vector2.new(point.X, point.Y) - center).Magnitude
                        if distance <= sheriffDuelsRadius and distance < bestDistance then
                            best, bestDistance = player, distance
                        end
                    end
                end
            end
        end
        return best
    end
    local lastDuelMessage = 0
    local function duelStatusMessage()
        if os.clock() - lastDuelMessage < 3 then return end
        lastDuelMessage = os.clock()
        local myTeam = getDuelsTeamToken(LocalPlayer)
        local enemies = 0
        for _,p in ipairs(Players:GetPlayers()) do
            if isConfirmedDuelsEnemy(p) then enemies += 1 end
        end
