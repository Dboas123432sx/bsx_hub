        else
            fu.notification("Duels: nenhum adversario confirmado nesta rodada.")
        end
    end

	local function shootPlayer(target)
		local character = LocalPlayer.Character
		if not character then return end
		local gun = findEquippedSheriffGun()
		if not gun then
			fu.notification("Arma Sheriff com Remote Shoot nao encontrada.")
			return
		end

        if sheriffDuelsMode then
            -- Ignora Player Target e nao faz fallback para aliados no Duels.
            target = sheriffTargetInsideFov()
            if not target then duelStatusMessage(); return end
        else
            -- Mantem exatamente o comportamento original fora do Duels.
            if not target or not alive(target) or target == LocalPlayer then
                target = findMurderer()
            end
            if not target or target == LocalPlayer or not alive(target) then
                target = findDuelSheriffTarget()
            end
        end
		if not target or not target.Character then
			fu.notification("Alvo nao encontrado (selecione Player Target no Duels).")
			return
		end

		local shootRemote = gun:FindFirstChild("Shoot")
		if not shootRemote or not shootRemote:IsA("RemoteEvent") then
			fu.notification("Remote Shoot nao encontrado na arma.")
			return
		end

		local targetCharacter = target.Character
		local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
		if not targetHumanoid or targetHumanoid.Health <= 0 then return end

		local torso = targetCharacter:FindFirstChild("UpperTorso")
			or targetCharacter:FindFirstChild("Torso")
			or targetCharacter:FindFirstChild("HumanoidRootPart")
