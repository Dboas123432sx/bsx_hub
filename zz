    -- UI elements use scale coordinates and scrolling frames, so they reflow with the window.

    -- Fade In / Fade Out without moving or changing existing module objects.
    local visibilityToken = 0
    local function setVisible(wantVisible)
        if shown == wantVisible then return end
        shown = wantVisible
        visibilityToken += 1
        local token = visibilityToken
        transitioning = true
        if wantVisible then
            menu.Visible = true
            menu.UIScale.Scale = 0.97
        end
        local list = {menu, sidebar, area}
        for _, item in ipairs(list) do
            if wantVisible then item.BackgroundTransparency = 1 end
            tween(item, {BackgroundTransparency = wantVisible and glass or 1})
        end
        tween(menu.UIScale, {Scale = wantVisible and 1 or 0.97})
        task.delay(duration + 0.03, function()
            if token ~= visibilityToken then return end
            if not wantVisible then menu.Visible = false end
            transitioning = false
        end)
    end
    UserInputService.InputBegan:Connect(function(input, processed)
        if listening then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                listening = false
                if input.KeyCode ~= Enum.KeyCode.Unknown then
                    keybind = input.KeyCode
                end
                keyButton.Text = keybind.Name .. "  ·  Alterar tecla"
            end
            return
        end
        if processed or UserInputService:GetFocusedTextBox() then return end
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == keybind then
            setVisible(not shown)
        end
    end)

    -- Narrow displays: scale entire UI while keeping native internal layout.
    local camera = workspace.CurrentCamera
    local function adjustScale()
        camera = workspace.CurrentCamera
        if not camera then return end
        local view = camera.ViewportSize
        if menu:FindFirstChild("UIScale") then
            local widthScale = (view.X - 24) / 700
            local heightScale = (view.Y - 24) / 480
            menu.UIScale.Scale = math.clamp(math.min(1, widthScale, heightScale), 0.55, 1)
        end
    end
    if camera then camera:GetPropertyChangedSignal("ViewportSize"):Connect(adjustScale) end
    adjustScale()
