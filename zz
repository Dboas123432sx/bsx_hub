    local function applyESP(rec,part,character,role,gunMode)
        if not part or not character then cleanRecord(rec); return end
        local color=colors[role] or Color3.new(1,1,1)
        local chams=espEnabled.Chams[role]
        local outline=espEnabled.Outline[role]
        if chams or outline then
            if not rec.highlight or rec.highlight.Parent~=character then
                destroyObject(rec.highlight)
                rec.highlight=Instance.new("Highlight")
                rec.highlight.Name="CatNoir_RoleHighlight"
                rec.highlight.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
                rec.highlight.Adornee=character
                rec.highlight.Parent=character
            end
            if rec.highlight.FillColor~=color then rec.highlight.FillColor=color end
            if rec.highlight.OutlineColor~=color then rec.highlight.OutlineColor=color end
            local fill=chams and 0.5 or 1
            local outer=outline and 0 or 1
            if rec.highlight.FillTransparency~=fill then rec.highlight.FillTransparency=fill end
            if rec.highlight.OutlineTransparency~=outer then rec.highlight.OutlineTransparency=outer end
        else destroyObject(rec.highlight);rec.highlight=nil end

        if espEnabled.Box[role] then
            if not rec.box or rec.box.Adornee~=part then
                destroyObject(rec.box)
                rec.box=Instance.new("BoxHandleAdornment")
                rec.box.Name="CatNoir_RoleBox"
                rec.box.Adornee=part
                rec.box.AlwaysOnTop=true
                rec.box.Size=gunMode and (part:IsA("BasePart") and part.Size or Vector3.new(2,1,1)) or Vector3.new(4,6,3)
                rec.box.Transparency=.45
                rec.box.ZIndex=3
                rec.box.Parent=part
            end
            if rec.box.Color3~=color then rec.box.Color3=color end
        else destroyObject(rec.box);rec.box=nil end

        if espEnabled.Tracers[role] then
            if not rec.beam or rec.targetPart~=part then
                destroyObject(rec.beam);destroyObject(rec.targetAttach)
                rec.targetAttach=Instance.new("Attachment")
                rec.targetAttach.Name="CatNoir_RoleTracerTarget"
                rec.targetAttach.Parent=part
                rec.beam=Instance.new("Beam")
                rec.beam.Name="CatNoir_RoleTracer"
                rec.beam.Attachment1=rec.targetAttach
                rec.beam.Width0=.045;rec.beam.Width1=.045
                rec.beam.FaceCamera=true
                rec.beam.Transparency=NumberSequence.new(.17)
                rec.beam.Parent=part
                rec.targetPart=part
            end
            local myRoot=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local origin=myRoot:FindFirstChild("CatNoir_TracerOrigin")
                if not origin then
                    origin=Instance.new("Attachment")
                    origin.Name="CatNoir_TracerOrigin"
                    origin.Parent=myRoot
                end
                if rec.beam.Attachment0~=origin then rec.beam.Attachment0=origin end
                if rec.lastTracerColor~=color then
                    rec.beam.Color=ColorSequence.new(color)
                    rec.lastTracerColor=color
                end
            end
        else
            destroyObject(rec.beam);rec.beam=nil
            destroyObject(rec.targetAttach);rec.targetAttach=nil
            rec.targetPart=nil
        end
    end
