    local function isMapPart(part)
        if not part:IsA("BasePart") or not part:IsDescendantOf(workspace) then return false end
        if part:FindFirstAncestorWhichIsA("Tool") then return false end
        local parent = part.Parent
        while parent and parent ~= workspace do
            if parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") then return false end
            parent = parent.Parent
        end
        return true
    end
    local function revertAll()
        for part, saved in pairs(originalTextures) do
            for _, tex in ipairs(saved.added) do
                if tex then tex:Destroy() end
            end
            if part and part.Parent then
                part.Material = saved.material
                part.Color = saved.color
                part.Reflectance = saved.reflectance
                for visual, transparency in pairs(saved.hiddenVisuals) do
                    if visual and visual.Parent then
                        visual.Transparency = transparency
                    end
                end
            end
            originalTextures[part] = nil
        end
    end
    local function applyToPart(part)
        if not activePack or not isMapPart(part) or originalTextures[part] then return end
        local material = part.Material
        local id = materialTextures[material.Name]
        if activePack == "Minecraft" and not id then return end
        local saved = {
            material = material, color = part.Color, reflectance = part.Reflectance,
            added = {}, hiddenVisuals = {}
        }
        originalTextures[part] = saved
        if activePack == "Dark Black" then
            -- Dark Black Remastered: mais escuro e com distribuicao consistente.
            -- O objetivo e combinar melhor com o mapa, separando piso, paredes e estruturas.
            local name = part.Name:lower()
            local size = part.Size
            local materialChoice = Enum.Material.SmoothPlastic
            local tint = Color3.fromRGB(24, 24, 24)

            local isVeryFlat = size.Y <= math.min(size.X, size.Z) * 0.18
            local isWideHorizontal = isVeryFlat and size.X > 4 and size.Z > 4
            local isTall = size.Y > math.max(size.X, size.Z) * 1.2
            local isPillar = isTall and size.X <= 4 and size.Z <= 4
            local isWallLike = isTall and (size.X <= 2.5 or size.Z <= 2.5)

            if name:find("ceiling") or name:find("roof") or name:find("teto") then
                tint = Color3.fromRGB(5, 5, 5)
                materialChoice = Enum.Material.SmoothPlastic
            elseif name:find("floor") or name:find("ground") or name:find("chao") or name:find("chão") or name:find("baseplate") then
                tint = Color3.fromRGB(18, 18, 18)
                materialChoice = Enum.Material.Slate
            elseif name:find("ramp") or name:find("stairs") or name:find("stair") or name:find("escada") then
                tint = Color3.fromRGB(16, 16, 16)
                materialChoice = Enum.Material.Slate
            elseif name:find("wall") or name:find("parede") then
                tint = Color3.fromRGB(7, 7, 7)
                materialChoice = Enum.Material.SmoothPlastic
            elseif name:find("door") or name:find("porta") then
                tint = Color3.fromRGB(28, 28, 28)
                materialChoice = Enum.Material.Metal
            elseif name:find("frame") or name:find("trim") or name:find("beam") or name:find("pillar") or name:find("column") or name:find("support") then
                tint = Color3.fromRGB(32, 32, 32)
                materialChoice = Enum.Material.Metal
            elseif isPillar then
                tint = Color3.fromRGB(30, 30, 30)
                materialChoice = Enum.Material.Metal
            elseif isWallLike then
                tint = Color3.fromRGB(8, 8, 8)
                materialChoice = Enum.Material.SmoothPlastic
            elseif isWideHorizontal then
                tint = Color3.fromRGB(20, 20, 20)
                materialChoice = Enum.Material.Slate
            else
                tint = Color3.fromRGB(26, 26, 26)
                materialChoice = Enum.Material.Concrete
            end

            part.Color = tint
            part.Material = materialChoice
            part.Reflectance = 0
            -- Texturas e decals originais do mapa permanecem visiveis.
        elseif colorPalettes[activePack] then
            local palette = colorPalettes[activePack]
            local name = part.Name:lower()
            local size = part.Size
            local wideFloor = size.Y <= math.min(size.X, size.Z) * 0.24
            local tallWall = size.Y >= 3 and (size.X <= 2.5 or size.Z <= 2.5)
            local trim = name:find("trim") or name:find("frame") or name:find("beam")
                or name:find("pillar") or name:find("column") or name:find("support")
                or name:find("railing") or name:find("rail")
            local accent = name:find("door") or name:find("porta") or name:find("stairs")
                or name:find("ramp") or name:find("escada") or name:find("window")
            local isFloor = name:find("floor") or name:find("ground")
                or name:find("chao") or name:find("baseplate") or name:find("platform")
            local isCeiling = name:find("ceiling") or name:find("roof") or name:find("teto")
            local isWall = name:find("wall") or name:find("parede")
            if activePack == "Halloween" then
                -- Preserva a distribuicao original da textura Halloween.
                if trim then
                    part.Color = palette.detail
                    part.Material = Enum.Material.Metal
                elseif accent then
                    part.Color = palette.accent
                    part.Material = Enum.Material.SmoothPlastic
                elseif isFloor or (wideFloor and not (isWall or isCeiling)) then
                    part.Color = palette.floor
                    part.Material = Enum.Material.Slate
                elseif isWall or isCeiling or tallWall then
                    part.Color = palette.wall
                    part.Material = Enum.Material.SmoothPlastic
                else
                    part.Color = palette.detail
                    part.Material = Enum.Material.SmoothPlastic
                end
            else
                -- Novo acabamento nas outras 7 paletas: pisos coloridos, paredes
                -- com profundidade e estruturas em uma tonalidade intermediaria.
                if isCeiling then
                    part.Color = palette.ceiling
                    part.Material = Enum.Material.SmoothPlastic
                elseif trim then
                    part.Color = palette.structure
                    part.Material = Enum.Material.Metal
                elseif accent then
                    part.Color = palette.accent
                    part.Material = Enum.Material.SmoothPlastic
                elseif isFloor or (wideFloor and not isWall) then
                    part.Color = palette.floor
                    part.Material = Enum.Material.Slate
                elseif isWall or tallWall then
                    part.Color = palette.wall
                    part.Material = Enum.Material.SmoothPlastic
                else
                    part.Color = palette.detail
                    part.Material = Enum.Material.SmoothPlastic
                end
            end
            part.Reflectance = 0
            -- Preserva as texturas e decals originais do mapa.
        else
            for _, face in ipairs(faces) do
                local tex = Instance.new("Texture")
                tex.Name = "CatNoirTexturePack"
                tex.Texture = "rbxassetid://" .. id
                tex.Face = face
                tex.Color3 = part.Color
                tex.Transparency = part.Transparency
                tex.Parent = part
                table.insert(saved.added, tex)
            end
            part.Material = Enum.Material.SmoothPlastic
        end
    end
    local function changePack(nextPack)
        textureGeneration += 1
        local generation = textureGeneration
        if textureConn then textureConn:Disconnect(); textureConn = nil end
        revertAll()
        activePack = nextPack
        if not nextPack then return end
        textureConn = workspace.DescendantAdded:Connect(function(obj)
            task.defer(function()
                if textureGeneration == generation then applyToPart(obj) end
            end)
        end)
        task.spawn(function()
            local objects = workspace:GetDescendants()
            for index, obj in ipairs(objects) do
                if textureGeneration ~= generation then return end
                applyToPart(obj)
                if index % 150 == 0 then task.wait() end
            end
        end)
    end
    local function updateActivePack()
        changePack(customPackEnabled and selectedTexturePack or nil)
    end

